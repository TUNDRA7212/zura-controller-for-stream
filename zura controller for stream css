/* TEKKROH x ZURA ESPORTS | PS5 DualSense GamePad Viewer custom skin */
/* Base DualSense skin by brendanwelsh / Istador, MPL-2.0. */
@import url("https://brendanwelsh.github.io/playstation-ds5-white/style.css");

html, body { background: transparent !important; margin: 0; overflow: hidden; }
.custom.controller { filter: drop-shadow(0 0 1.3vw rgba(0,156,255,.85)) drop-shadow(0 0 2vw rgba(0,70,255,.35)); }
/* Tint shell and touchpad toward a cooler ZURA-blue palette. */
.custom.controller { background-color: transparent; }
.custom .quadrant { filter: hue-rotate(0deg) saturate(1.7) drop-shadow(0 0 .7vw #00aeff) !important; }
.custom .stick { filter: drop-shadow(0 0 .65vw #009fff); }
.custom .stick.pressed { filter: brightness(1.35) drop-shadow(0 0 1.1vw #00d8ff); }
.custom .button.pressed, .custom .face.pressed, .custom .bumper.pressed,
.custom .trigger.pressed, .custom .back.pressed, .custom .start.pressed {
 filter: brightness(1.65) drop-shadow(0 0 .9vw #00caff);
}
/* Keep original touchpad sprite and working press animation. Add a team badge above it. */
.custom .touchpad::after {
 content: "";
 position: absolute;
 width: 40%; height: 76%; left: 30%; top: 9%;
 background-image: url("data:image/png;base64,");
 background-position: center; background-repeat: no-repeat; background-size: contain;
 pointer-events: none;
 filter: drop-shadow(0 0 .45vw #00aaff);
}
/* Small player tag, separate from controller controls. */
.custom.controller::before {
 content: "TEKKROH  |  ZURA ESPORTS";
 position: absolute; left: 27%; top: 63%; width: 46%;
 color: #b9eaff; font: 900 1.5vw Arial, sans-serif; letter-spacing: .18vw;
 text-align: center; text-shadow: 0 0 .6vw #009dff;
 pointer-events: none;
}
